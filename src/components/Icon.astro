---
interface Props { name?: 'arrow' | 'phone' | 'pin' | 'star'; class?: string }
const { name = 'arrow', class: className } = Astro.props;
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'phone' && <path d="m8 3 3 5-3 3c1 3 2 4 5 5l3-3 5 3c0 4-2 5-5 5C9 20 4 15 3 8c0-3 1-5 5-5Z" />}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'star' && <path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" />}
</svg>
