---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import llama from '../assets/llama-v-arranz.png';
import { restaurant } from '../data/restaurant';
---
<footer class="site-footer">
  <div class="footer-top"><a class="wordmark footer-brand" href="/"><Image src={llama} alt="" width={42} format="webp" /><span>V. Arranz<small>BAR & RESTAURANTE</small></span></a><p>Buena cocina.<br />Mejor compañía.</p><a class="text-link" href={restaurant.phoneHref}>{restaurant.phone} <Icon name="phone" /></a></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} V. Arranz</span><span>San Sebastián de los Reyes · Madrid</span><a href="#">Volver arriba ↑</a></div>
</footer>
