---
import Icon from './Icon.astro';
import { restaurant } from '../data/restaurant';
// Original Google Maps embed identifies the restaurant by its place ID.
const embed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3031.1097087689864!2d-3.624656784963432!3d40.56125447934856!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd422cdf60b755f9%3A0x2437c7a6e1c9eb7!2sV.+Arranz!5e0!3m2!1sen!2ses!4v1474846566728';
---
<div class="restaurant-map">
  <iframe src={embed} title="Ubicación de V. Arranz en Paseo de María de Maeztu, 7, San Sebastián de los Reyes" width="800" height="460" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  <div class="map-caption"><span><Icon name="pin" /> Paseo de María de Maeztu, 7</span><a href={restaurant.maps} target="_blank" rel="noopener noreferrer">Abrir en Google Maps <span aria-hidden="true">↗</span></a></div>
</div>
<style>
  .restaurant-map { background: var(--paper); color: var(--wine); }
  iframe { display: block; width: 100%; height: 460px; border: 0; }
  .map-caption { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding: 22px 25px; font-size: 11px; }
  .map-caption > span { display: flex; align-items: center; gap: 10px; }
  .map-caption a { display: inline-flex; gap: 15px; align-items: center; padding-block: 6px; border-bottom: 1px solid var(--wine); }
  @media (max-width: 600px) { iframe { height: 330px; } .map-caption { padding: 18px; } }
</style>
