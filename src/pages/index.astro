---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import RestaurantMap from '../components/RestaurantMap.astro';
import { restaurant } from '../data/restaurant';
import salon from '../assets/salon.png';
import foie from '../assets/foie.png';
import tartar from '../assets/tartar.png';
import postres from '../assets/postres.png';
import detalle from '../assets/detalle.png';
import eventos from '../assets/eventos.png';
import bogavante from '../assets/bogavante-google.jpg';
const dishes = [
  { image: foie, title: 'Terrina casera de foie', category: 'PARA ABRIR BOCA', href: '/carta/#entrantes' },
  { image: tartar, title: 'Tartar de solomillo', category: 'CON NUESTRO SELLO', href: '/carta/#carnes' },
  { image: postres, title: 'Un final muy casero', category: 'GUARDA UN HUECO', href: '/carta/#postres' },
];
---
<Layout>
  <section class="hero section-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-star">✳</span> COCINA DE SIEMPRE, DESDE 2008</p>
      <h1 id="hero-title">El gusto<br /> de <em>volver.</em></h1>
      <p class="hero-description">Hay mesas que se convierten en costumbre.<br class="desktop-break" /> Cocina con raíces, una buena copa y todo<br class="desktop-break" /> el tiempo para disfrutar.</p>
      <div class="hero-actions"><a class="button" href="/carta/">Descubre la carta <Icon /></a><a class="text-link" href={restaurant.phoneHref} aria-label={`Llamar al ${restaurant.phone} para reservar`}>Llamar <Icon name="phone" /></a></div>
      <div class="hero-location"><Icon name="pin" /><span>Tu mesa en San Sebastián de los Reyes<br /> <small>Paseo de María de Maeztu, 7 · Madrid</small></span></div>
    </div>
    <div class="hero-visual">
      <Image class="hero-image" src={salon} alt="Mesas vestidas de blanco y burdeos en el salón de V. Arranz" widths={[640, 960, 1440]} sizes="(max-width: 700px) 100vw, 52vw" width={960} format="webp" quality={85} loading="eager" fetchpriority="high" />
      <div class="round-stamp" aria-label="Cocina con alma, hecha en casa"><span>COCINA CON ALMA</span><Icon name="star" /><span>HECHA EN CASA</span></div>
      <div class="photo-label"><span>01 — NUESTRA CASA</span><span>Pasa. Estás en tu sitio.</span></div>
    </div>
  </section>
  <div class="manifesto-strip" aria-label="Nuestra esencia"><span>Raíces vasco-francesas</span><Icon name="star" /><span>El placer de compartir</span><Icon name="star" /><span>Postres hechos en casa</span><Icon name="star" /><span>Sobremesas sin prisa</span></div>
  <section id="restaurante" class="story section-shell section-space">
    <div class="story-images"><Image class="story-main" src={detalle} alt="La luz cálida de los cristales de sal del salón" width={660} format="webp" loading="lazy" /><div class="story-caption"><span>Una casa con carácter.</span><span>Y las puertas abiertas.</span></div></div>
    <div class="story-copy"><p class="eyebrow">BIENVENIDO A V. ARRANZ</p><h2>De nuestra cocina.<br /> <em>De toda la vida.</em></h2><p>Nos gusta la cocina que tiene algo que contar. La que nace de las raíces vasco-francesas, se prepara con cariño y llega a la mesa para compartir.</p><p>Desde 2008, nuestra casa en San Sebastián de los Reyes reúne platos de siempre, postres caseros y la calidez de un salón con personalidad. Tú traes la compañía. Nosotros ponemos la mesa.</p><a class="text-link" href="/restaurante/">Conoce nuestra casa <Icon /></a><div class="story-signature">V. Arranz <span>BIENVENIDO A CASA</span></div></div>
  </section>
  <section class="specialties section-space" aria-labelledby="specialties-title">
    <div class="section-shell"><div class="section-heading"><div><p class="eyebrow">BUEN PRODUCTO. BUENAS MANOS.</p><h2 id="specialties-title">Hay sabores que <em>se quedan.</em></h2></div><a class="text-link" href="/carta/">Ver toda la carta <Icon /></a></div>
      <div class="dish-grid">{dishes.map(dish => <a class="dish-card" href={dish.href}><div class="dish-photo"><Image class="food-photo" src={dish.image} alt={dish.title} width={700} format="webp" loading="lazy" /><span class="dish-arrow"><Icon /></span></div><p class="eyebrow">{dish.category}</p><h3>{dish.title}</h3></a>)}</div>
      <p class="menu-footnote">Del primer aperitivo al último café. <a href="/carta/">Encuentra tu próximo plato favorito.</a></p>
    </div>
  </section>
  <section class="gallery-preview section-shell section-space" aria-labelledby="gallery-preview-title">
    <div class="gallery-preview-heading"><div><p class="eyebrow">UN POCO DE NUESTRA CASA</p><h2 id="gallery-preview-title">Una mirada antes<br /> de <em>sentarte a la mesa.</em></h2></div><a class="text-link" href="/galeria/">Ver la galería <Icon /></a></div>
    <div class="gallery-preview-images"><Image src={salon} alt="El salón de V. Arranz preparado para recibir a sus clientes" width={720} format="webp" loading="lazy" /><Image class="food-photo" src={bogavante} alt="Ensalada de bogavante servida en V. Arranz" width={540} format="webp" loading="lazy" /><Image src={detalle} alt="Una vista del comedor y sus cuadros" width={540} format="webp" loading="lazy" /></div>
  </section>
  <section id="celebraciones" class="celebrations section-shell section-space">
    <div class="celebration-copy"><p class="eyebrow">LOS BUENOS MOMENTOS, A LA MESA</p><h2>El motivo lo pones tú.<br /> <em>La mesa, nosotros.</em></h2><p>Un cumpleaños, una comida de familia, una cena de empresa. O simplemente las ganas de juntarse. Hay ocasiones que merecen una buena sobremesa.</p><p>Cuéntanos qué quieres celebrar y hablemos del menú y de los detalles.</p><a class="button" href={restaurant.phoneHref}>Hablemos de tu celebración <Icon name="phone" /></a><span class="celebration-note">Familia · Amigos · Empresa</span></div>
    <div class="celebration-photo"><Image src={eventos} alt="Brindis con copas de vino para celebrar juntos" width={900} format="webp" loading="lazy" /><span class="image-note">Las mejores historias empiezan alrededor de una mesa.</span></div>
  </section>
  <section id="contacto" class="contact-section">
    <div class="section-shell"><div class="contact-heading"><p class="eyebrow">TE GUARDAMOS UN SITIO</p><h2>Nos vemos <em>en la mesa.</em></h2><a class="contact-phone" href={restaurant.phoneHref}>{restaurant.phone}<Icon name="phone" /></a><p>Una llamada, una mesa y un buen plan.</p></div>
    <div class="contact-grid"><div><p class="eyebrow">VEN A VERNOS</p><address>{restaurant.address}<br /> {restaurant.locality}<br /> 28702 · Madrid</address><a class="text-link" href={restaurant.maps} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div><div><p class="eyebrow">CUÁNDO NOS VEMOS</p><dl class="hours"><div><dt>Miércoles a sábado</dt><dd>12:00 – 23:45</dd></div><div><dt>Domingo</dt><dd>12:00 – 18:00</dd></div><div class="closed"><dt>Lunes y martes</dt><dd>Descansamos</dd></div></dl></div><div><p class="eyebrow">TU PRÓXIMA VISITA</p><p>Reserva por teléfono y cuéntanos<br /> cuántos venís. Nosotros nos<br /> ocupamos del resto.</p><a class="text-link" href={restaurant.phoneHref}>Llamar para reservar <Icon name="phone" /></a></div></div></div>
    <div class="section-shell" style="margin-top:45px"><RestaurantMap /></div>
  </section>
</Layout>
<style>
  .gallery-preview-heading { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 35px; }
  .gallery-preview-heading h2 { font-size: clamp(42px, 4.5vw, 64px); }
  .gallery-preview-images { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 14px; }
  .gallery-preview-images img { width: 100%; height: 285px; object-fit: cover; }
  .food-photo { filter: brightness(1.04) contrast(.97) saturate(.92) sepia(.025); }
  @media (max-width: 900px) { .gallery-preview-images img { height: 220px; } }
  @media (max-width: 600px) {
    .gallery-preview-heading { align-items: start; flex-direction: column; gap: 16px; }
    .gallery-preview-heading h2 { font-size: 43px; }
    .gallery-preview-images { grid-template-columns: 1fr 1fr; gap: 10px; }
    .gallery-preview-images img { height: 180px; }
    .gallery-preview-images img:first-child { grid-column: 1 / -1; height: 245px; }
  }
</style>
