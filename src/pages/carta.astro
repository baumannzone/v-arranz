---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { menu, formatPrice, restaurant, sharingMenus, sharingMenuMains } from '../data/restaurant';
---
<Layout title="La carta · V. Arranz" description="Menús para compartir, raciones, entrantes, pescados, carnes, postres caseros y bodega. Descubre la carta de V. Arranz en San Sebastián de los Reyes.">
  <section class="menu-hero section-shell"><a class="back-link" href="/">← Inicio</a><p class="eyebrow">COCINA CON RAÍCES. A TU GUSTO.</p><h1>Hoy, ¿qué <em>te apetece?</em></h1><p>Para compartir, para darte un homenaje, para volver.<br /> Elige cómo empieza tu sobremesa.</p></section>
  <div class="menu-navigation"><div class="section-shell"><nav aria-label="Categorías de la carta">{menu.map(category => <a href={`#${category.id}`}>{category.name}</a>)}<a href="#menus-compartir">Menús para compartir</a></nav></div></div>
  <div class="menu-content section-shell">{menu.map((category, index) => <section class="menu-category" id={category.id} aria-labelledby={`title-${category.id}`}><div class="category-intro"><span class="category-number">0{index + 1}</span><h2 id={`title-${category.id}`}>{category.name}</h2><p>{category.intro}</p></div><ul class="menu-items">{category.dishes.map(([name, price]) => <li><span>{name}</span><span class="price">{formatPrice(price)}</span></li>)}</ul></section>)}
    <section class="menu-category" id="menus-compartir" aria-labelledby="title-menus-compartir">
      <div class="category-intro"><span class="category-number">08</span><h2 id="title-menus-compartir">Menús para compartir</h2><p>Entradas al centro y un segundo a tu gusto.</p></div>
      <div class="sharing-menus">
        {sharingMenus.map(sharingMenu => <article class="sharing-menu">
          <header><h3>{sharingMenu.name}</h3><p><span class="price">{formatPrice(sharingMenu.price)}</span> <span>por persona</span></p></header>
          <p class="sharing-aperitif">Aperitivo frío y caliente</p>
          <h4>Entradas a compartir · a elegir {sharingMenu.starterCount}</h4>
          <ul>{sharingMenu.starters.map(dish => <li>{dish}</li>)}</ul>
          <h4>Segundo a elegir</h4>
          <ul>{sharingMenuMains.map(dish => <li>{dish}</li>)}</ul>
          <h4>Postre</h4><p>Postre variado</p>
          <h4>Bebidas y café</h4><p>Rioja o Ribera crianza y agua.<br />Café o infusiones.</p>
        </article>)}
      </div>
    </section>
    <p class="allergen-note">Si tienes alguna alergia o intolerancia, consúltanos antes de pedir. Disponibilidad y precios sujetos a confirmación en el restaurante.</p></div>
  <section class="menu-cta"><p class="eyebrow">EL SIGUIENTE PASO ES SENTARSE</p><h2>Tu mesa <em>te espera.</em></h2><a class="button" href={restaurant.phoneHref}>Llamar · {restaurant.phone} <Icon name="phone" /></a></section>
</Layout>

<script>
  const navigation = document.querySelector<HTMLElement>('.menu-navigation');
  const nav = navigation?.querySelector<HTMLElement>('nav');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [])];
  const categories = links.map(link => ({ link, section: document.getElementById(link.hash.slice(1)) })).filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section instanceof HTMLElement);
  let activeLink: HTMLAnchorElement | undefined;
  let scheduled = false;

  function updateActiveCategory() {
    scheduled = false;
    if (!navigation || !nav) return;
    const marker = navigation.getBoundingClientRect().bottom + Math.min(80, window.innerHeight * 0.15);
    const current = categories.find(({ section }) => {
      const bounds = section.getBoundingClientRect();
      return bounds.top <= marker && bounds.bottom > marker;
    })?.link;
    if (current === activeLink) return;
    activeLink?.removeAttribute('aria-current');
    activeLink = current;
    if (!current) return;
    current.setAttribute('aria-current', 'location');
    const left = current.offsetLeft - (nav.clientWidth - current.clientWidth) / 2;
    nav.scrollTo({ left, behavior: 'smooth' });
  }

  function scheduleUpdate() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateActiveCategory);
  }

  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  window.addEventListener('hashchange', scheduleUpdate);
  window.addEventListener('load', scheduleUpdate);
  scheduleUpdate();
</script>

<style>
  .sharing-menus { display: grid; gap: 36px; min-width: 0; }
  .sharing-menu { padding: 28px; border: 1px solid var(--line); background: var(--paper); }
  .sharing-menu header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; }
  .sharing-menu h3 { font-size: 30px; color: var(--wine); }
  .sharing-menu header p { font-size: 12px; }
  .sharing-menu .price { font-size: 22px; }
  .sharing-menu h4 { font-size: 14px; margin-top: 24px; margin-bottom: 8px; }
  .sharing-menu p, .sharing-menu li { font-size: 14px; }
  .sharing-menu ul { padding-left: 18px; margin: 0; }
  .sharing-menu li + li { margin-top: 5px; }
  .sharing-aperitif { margin-top: 20px; }
  @media (max-width: 600px) { .sharing-menu { padding: 20px; } }
</style>
